    {
      "id": "hazard-4",
      "kind": "Hazard",
      "title": "A corridor that is longer each time you look",
      "depth": "any",
      "plain": "The corridor runs forty meters to a sealed hatch. You look again. Sixty.",
      "uneasy": "The corridor keeps going. The deck plates repeat: the same scuff, the same missing bolt, as if the ship is running out of ideas.",
      "eldritch": "The passage unspools before you at angles no shipwright ever drafted, each bulkhead older than the last, and you understand with a cold and sinking certainty that it is not growing longer. You are being let further in.",
      "status": "canon",
      "notes": "",
      "order": 10,
      "breakthrough": ""
    },
