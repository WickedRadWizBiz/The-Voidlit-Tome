root ::= (
  "{\"intent\": \"" intent "\", "
  "\"stat\": \"" stat "\", "
  "\"target\": \"" target "\", "
  "\"aggression\": " unit ", "
  "\"deception\": " unit ", "
  "\"leverage\": " unit ", "
  "\"exposure\": " unit ", "
  "\"rapport\": " signed ", "
  "\"boldness\": " unit "}"
)
intent ::= "look" | "talk" | "fight" | "force" | "sneak" | "search" | "use" | "rest" | "advance" | "flee" | "other"
stat ::= "might" | "grace" | "wits" | "nerve" | "none"
target ::= "none"
unit ::= ("0." [0-9] [0-9]?) | "1.0"
signed ::= "-"? unit

