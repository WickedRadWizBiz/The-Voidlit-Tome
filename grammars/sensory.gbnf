# Reference sensory grammar (generated by `python -m voidlit gbnf --targets elara,marcus,tome --topics light,tome,way_out`).
# At runtime the brain rebuilds it every turn so `target` and `asks` only allow what is in the current scene.
root ::= (
  "{\"intent\": \"" intent "\", "
  "\"approach\": \"" approach "\", "
  "\"target\": \"" target "\", "
  "\"aggression\": " unit ", "
  "\"deception\": " unit ", "
  "\"leverage\": " unit ", "
  "\"exposure\": " unit ", "
  "\"rapport\": " signed ", "
  "\"boldness\": " unit ", "
  "\"asks\": \"" asks "\", "
  "\"claims\": \"" claims "\", "
  "\"addressed_tome\": " bool "}"
)
intent ::= "look" | "talk" | "fight" | "force" | "sneak" | "search" | "use" | "rest" | "advance" | "flee" | "other"
approach ::= "grit" | "guile" | "insight" | "none"
target ::= "none" | "elara" | "marcus" | "tome"
asks ::= "none" | "vague" | "unclear" | "light" | "tome" | "way_out"
claims ::= "none"
bool ::= "true" | "false"
unit ::= ("0." [0-9] [0-9]?) | "1.0"
signed ::= "-"? unit

