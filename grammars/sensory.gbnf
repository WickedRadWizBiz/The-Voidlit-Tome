# Reference sensory grammar (generated by `python -m voidlit gbnf --targets elara,marcus`).
# At runtime the brain rebuilds it every turn so `target` only allows entities in the current scene.
root ::= (
  "{\"intent\": \"" intent "\", "
  "\"approach\": \"" approach "\", "
  "\"target\": \"" target "\", "
  "\"aggression\": " unit ", "
  "\"deception\": " unit ", "
  "\"leverage\": " unit ", "
  "\"exposure\": " unit ", "
  "\"rapport\": " signed ", "
  "\"boldness\": " unit "}"
)
intent ::= "look" | "talk" | "fight" | "force" | "sneak" | "search" | "use" | "rest" | "advance" | "flee" | "other"
approach ::= "grit" | "guile" | "insight" | "none"
target ::= "none" | "elara" | "marcus"
unit ::= ("0." [0-9] [0-9]?) | "1.0"
signed ::= "-"? unit

